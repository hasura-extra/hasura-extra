{
    "name": "hasura-extra/bundle",
    "license": "MIT",
    "description": "Symfony bundle to build modern web APIs with Hasura graphql engine.",
    "autoload": {
        "psr-4": {
            "Hasura\\Bundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hasura\\Bundle\\Tests\\": "tests",
            "Hasura\\Bundle\\Tests\\Fixture\\App\\": "tests/Fixture/src"
        }
    },
    "require": {
        "php": ">=8.4",
        "hasura-extra/auth-hook": "^6.1",
        "hasura-extra/api-client": "^6.1",
        "hasura-extra/metadata": "^6.1",
        "hasura-extra/event-dispatcher": "^6.1",
        "symfony/http-kernel": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/psr7-pack": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.0",
        "phpunit/phpunit": "^10.4",
        "symfony/test-pack": "^1.0",
        "symfony/uid": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/security-bundle": "^8.0"
    },
    "conflict": {
        "hasura-extra/hasura-bundle": "*",
        "hasura-extra/laravel": "<2.5.0",
        "hasura-extra/graphql-scalars": "<6.0.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.1-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
